# Enlace real del podcast o episodio en Spotify.
PUBLIC_SPOTIFY_URL=https://open.spotify.com/search/Camina%20Conmigo

# Credenciales de la base de datos en Turso (libsql). Nunca lleven el
# prefijo PUBLIC_: son secretos de servidor, no deben llegar al cliente.
# Se obtienen con:
#   turso db show <nombre-db> --url
#   turso db tokens create <nombre-db>
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Credenciales del único usuario admin (panel en /admin). Guárdalas aquí en
# texto plano, nunca con prefijo PUBLIC_.
ADMIN_USER=
ADMIN_PASSWORD=

# Secreto usado para firmar la cookie de sesión (HMAC-SHA256). Genera uno
# largo y aleatorio, por ejemplo con:
#   openssl rand -hex 32
AUTH_SECRET=

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=