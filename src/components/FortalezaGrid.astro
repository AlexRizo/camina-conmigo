---
interface Entry {
  id: string;
  day: number;
  titulo: string;
  salmo: string;
}

interface Props {
  entries: Entry[];
}

const { entries } = Astro.props;

const INITIAL_BATCH = 24;
const initialEntries = entries.slice(0, INITIAL_BATCH);
const remainingEntries = entries.slice(INITIAL_BATCH);
// Escapa "<" para que el JSON embebido no pueda cerrar el <script> prematuramente.
const remainingJson = JSON.stringify(remainingEntries).replace(/</g, "\\u003c");
---

<section id="fortaleza" class="bg-cream px-[clamp(24px,7vw,110px)] py-[105px] max-[620px]:px-5 max-[620px]:py-[74px]">
  <div class="mx-auto max-w-[1100px]">
    <p class="m-0 flex items-center gap-3 text-[11px] font-bold uppercase tracking-[0.2em] text-blue">
      <span class="h-px w-[34px] bg-gold"></span>
      Cuando necesitas fortaleza
    </p>
    <h1 class="m-0 mt-6 max-w-[640px] font-serif text-[clamp(32px,4vw,48px)] leading-[1.1] font-normal tracking-[-0.03em] text-navy">
      365 oraciones para sostenerte, un día a la vez
    </h1>
    <p class="mt-4 max-w-[560px] font-serif text-lg leading-[1.7] text-muted">
      Elige cualquier día para leer su oración completa.
    </p>

    <div data-fortaleza-grid class="mt-10 grid grid-cols-3 gap-5 max-[900px]:grid-cols-2 max-[560px]:grid-cols-1">
      {
        initialEntries.map((entry) => (
          <a
            href={`/oraciones/oracion-para-fortaleza/${entry.id}`}
            class="block bg-paper p-6 shadow-[0_18px_60px_rgba(28,56,67,0.08)] transition-transform duration-150 hover:-translate-y-0.5"
          >
            <span class="text-[10px] font-bold uppercase tracking-[0.14em] text-gold">Día {entry.day}</span>
            <h2 class="m-0 mt-3 font-serif text-lg leading-[1.3] font-normal text-navy">{entry.titulo}</h2>
            <p class="mt-4 text-[10px] font-bold uppercase tracking-[0.12em] text-blue">{entry.salmo}</p>
          </a>
        ))
      }
    </div>

    <div data-fortaleza-sentinel class="h-px"></div>
    <p data-fortaleza-loading hidden class="mt-8 text-center text-[11px] font-bold uppercase tracking-[0.14em] text-muted">
      Cargando más oraciones…
    </p>
  </div>

  <script type="application/json" is:inline data-fortaleza-remaining set:html={remainingJson} />
</section>

<script>
  interface FortalezaCardEntry {
    id: string;
    day: number;
    titulo: string;
    salmo: string;
  }

  const grid = document.querySelector<HTMLElement>("[data-fortaleza-grid]");
  const sentinel = document.querySelector<HTMLElement>("[data-fortaleza-sentinel]");
  const loadingIndicator = document.querySelector<HTMLElement>("[data-fortaleza-loading]");
  const dataEl = document.querySelector<HTMLScriptElement>("script[data-fortaleza-remaining]");

  const remaining: FortalezaCardEntry[] = dataEl ? JSON.parse(dataEl.textContent || "[]") : [];
  const BATCH_SIZE = 24;

  function buildCard(entry: FortalezaCardEntry) {
    const link = document.createElement("a");
    link.href = `/oraciones/oracion-para-fortaleza/${entry.id}`;
    link.className =
      "block bg-paper p-6 shadow-[0_18px_60px_rgba(28,56,67,0.08)] transition-transform duration-150 hover:-translate-y-0.5";

    const day = document.createElement("span");
    day.className = "text-[10px] font-bold uppercase tracking-[0.14em] text-gold";
    day.textContent = `Día ${entry.day}`;

    const title = document.createElement("h2");
    title.className = "m-0 mt-3 font-serif text-lg leading-[1.3] font-normal text-navy";
    title.textContent = entry.titulo;

    const salmo = document.createElement("p");
    salmo.className = "mt-4 text-[10px] font-bold uppercase tracking-[0.12em] text-blue";
    salmo.textContent = entry.salmo;

    link.append(day, title, salmo);
    return link;
  }

  function loadNextBatch() {
    if (remaining.length === 0) {
      observer.disconnect();
      loadingIndicator?.setAttribute("hidden", "");
      return;
    }
    loadingIndicator?.removeAttribute("hidden");
    const batch = remaining.splice(0, BATCH_SIZE);
    const fragment = document.createDocumentFragment();
    batch.forEach((entry) => fragment.append(buildCard(entry)));
    grid?.append(fragment);
    if (remaining.length === 0) {
      observer.disconnect();
      loadingIndicator?.setAttribute("hidden", "");
    }
  }

  const observer = new IntersectionObserver(
    (observedEntries) => {
      if (observedEntries.some((e) => e.isIntersecting)) loadNextBatch();
    },
    { rootMargin: "600px" },
  );

  if (sentinel && remaining.length > 0) observer.observe(sentinel);
</script>
