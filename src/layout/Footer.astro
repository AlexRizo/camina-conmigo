---
const spotifyUrl =
  import.meta.env.PUBLIC_SPOTIFY_URL ||
  "https://open.spotify.com/search/Camina%20Conmigo";

const links = [
  { href: "#podcast", label: "Podcast" },
  { href: "#sobre-proyecto", label: "Sobre el proyecto" },
  { href: "#oracion", label: "Intenciones de oración" },
  { href: "#reflexiones", label: "Reflexiones" },
];
---

<footer
  id="contacto"
  class="grid grid-cols-2 gap-15 bg-[#0b2636] px-[clamp(24px,7vw,110px)] pt-19 pb-6.25 text-white max-[620px]:grid-cols-1"
>
  <div>
    <a href="#inicio" class="inline-flex items-center gap-3.25">
      <span class="relative inline-block h-9.5 w-7.5" aria-hidden="true">
        <i class="absolute left-1/2 top-1/2 h-9 w-0.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-gold not-italic"></i>
        <b class="absolute left-1/2 top-[36%] h-0.5 w-4.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-gold font-normal not-italic"></b>
      </span>
      <span class="flex flex-col">
        <strong class="font-serif text-xl font-medium tracking-[-0.02em] text-white">Camina Conmigo</strong>
        <small class="mt-0.5 text-[8px] font-bold uppercase tracking-[0.18em] text-gold">
          La Palabra para tu camino
        </small>
      </span>
    </a>
    <p class="mt-6 max-w-97.5 font-serif text-[15px] leading-[1.7] text-white/50">
      Un espacio para escuchar, meditar y vivir el Evangelio cada día.
    </p>
    <!-- <a href="mailto:correo@prueba.org" class="mt-2 inline-block text-xs text-sand">
      correo@prueba.org
    </a> -->
  </div>

  <div class="grid grid-cols-2 content-start gap-3.5 pt-2">
    {
      links.map((link) => (
        <a href={link.href} class="text-[11px] text-white/62">
          {link.label}
        </a>
      ))
    }
    <a href={spotifyUrl} target="_blank" rel="noreferrer" class="text-[11px] text-white/62">
      Spotify
    </a>
  </div>

  <div
    class="col-span-full flex justify-between border-t border-white/10 pt-5.75 text-[8px] uppercase tracking-[0.12em] text-white/34 max-[620px]:col-span-1 max-[620px]:flex-col max-[620px]:gap-3"
  >
    <span>© 2026 Camina Conmigo</span>
    <span>www.caminaconmigo.org</span>
  </div>
</footer>
