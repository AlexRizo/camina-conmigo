---
import "@/styles/global.css";
import Footer from "./Footer.astro";
import Header from "./Header.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Camina Conmigo</title>
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="relative flex-1">
      <slot />
    </main>
    <Footer />

    <div
      data-route-loader
      hidden
      class="fixed inset-0 z-50 flex flex-col items-center justify-center gap-4 bg-cream/90 backdrop-blur-sm"
    >
      <span class="h-9 w-9 animate-spin rounded-full border-2 border-line border-t-gold"></span>
      <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-navy">Cargando…</p>
    </div>

    <script>
      const loader = document.querySelector<HTMLElement>("[data-route-loader]");

      // Solo las rutas que se renderizan en cada request (SSR) sufren cold start.
      // Todo /oraciones/oracion-para-fortaleza/* es estático (prerender), así que no necesita el loader.
      function needsLoader(pathname: string) {
        return (
          pathname.startsWith("/oraciones/oracion-para-iniciar-el-dia") ||
          pathname.startsWith("/oraciones/oracion-para-terminar-el-dia")
        );
      }

      document.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        const link = (event.target as HTMLElement).closest("a[href]") as HTMLAnchorElement | null;
        if (!link || link.target === "_blank") return;

        const url = new URL(link.href, window.location.href);
        if (url.origin !== window.location.origin) return;
        if (!needsLoader(url.pathname)) return;
        if (url.pathname === window.location.pathname) return;

        loader?.removeAttribute("hidden");
      });

      window.addEventListener("pageshow", () => {
        loader?.setAttribute("hidden", "");
      });
    </script>
  </body>
</html>
