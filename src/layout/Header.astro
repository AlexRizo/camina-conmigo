---
const linksBefore = [
  { href: "/#", label: "Inicio" },
  { href: "/#podcast", label: "Podcast" },
  { href: "/#sobre-proyecto", label: "Sobre el proyecto" },
];
const prayerLinks = [
  { href: "/oraciones/oracion-para-iniciar-el-dia", label: "Oración para iniciar el día" },
  { href: "/oraciones/oracion-para-fortaleza", label: "Cuando necesitas fortaleza" },
  { href: "/oraciones/oracion-para-terminar-el-dia", label: "Para terminar el día" },
];
const linksAfter = [
  { href: "/adviento", label: "Adviento" },
  { href: "/navidad", label: "Navidad" },
  { href: "/tiempo-ordinario", label: "Tiempo Ordinario" },
  { href: "/#reflexiones", label: "Reflexiones" },
  { href: "/#contacto", label: "Contacto" },
];
---

<header
  class="sticky backdrop-blur-sm inset-x-0 top-0 z-20 flex h-22 items-center justify-between bg-white/80 px-[clamp(24px,5vw,78px)] max-[900px]:h-19 max-[900px]:px-5.5"
>
  <a
    href="#inicio"
    aria-label="Camina Conmigo, inicio"
    class="inline-flex items-center gap-3.5"
  >
    <span class="relative inline-block h-9.5 w-7.5" aria-hidden="true">
      <i
        class="absolute left-1/2 top-1/2 h-9 w-0.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-gold not-italic"
      ></i>
      <b
        class="absolute left-1/2 top-[36%] h-0.5 w-4.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-gold font-normal not-italic"
      ></b>
    </span>
    <span class="flex flex-col">
      <strong
        class="font-serif text-xl font-medium tracking-[-0.02em] text-navy max-[900px]:text-lg"
      >
        Camina Conmigo
      </strong>
      <small
        class="mt-0.5 text-[8px] font-bold uppercase tracking-[0.18em] text-gold"
      >
        La Palabra para tu camino
      </small>
    </span>
  </a>

  <button
    type="button"
    data-menu-button
    aria-expanded="false"
    aria-controls="main-navigation"
    class="hidden flex-col items-center gap-1 border-0 bg-transparent p-2.5 max-[900px]:flex"
  >
    <span class="h-px w-6 bg-navy"></span>
    <span class="h-px w-6 bg-navy"></span>
    <span class="h-px w-6 bg-navy"></span>
    <span class="sr-only">Menú</span>
  </button>

  <nav
    id="main-navigation"
    data-menu
    class="flex items-center gap-[clamp(18px,2.2vw,38px)] max-[900px]:absolute max-[900px]:left-5 max-[900px]:right-5 max-[900px]:top-20 max-[900px]:z-20 max-[900px]:hidden max-[900px]:flex-col max-[900px]:items-start max-[900px]:gap-5.5 max-[900px]:bg-paper max-[900px]:p-7 max-[900px]:shadow-[0_18px_35px_rgba(12,38,53,0.12)] max-[900px]:data-open:flex"
  >
    {
      linksBefore.map((link) => (
        <a
          href={link.href}
          class="group relative pb-2 text-xs font-semibold uppercase tracking-[0.08em] text-[#536267]"
        >
          {link.label}
          <span class="absolute inset-x-0 -bottom-2 h-px origin-left scale-x-0 bg-gold transition-transform duration-200 ease-out group-hover:scale-x-100" />
        </a>
      ))
    }

    <details data-oraciones-dropdown class="group relative max-[900px]:w-full">
      <summary
        class="flex cursor-pointer list-none items-center gap-1.5 pb-2 text-xs font-semibold uppercase tracking-[0.08em] text-[#536267] [&::-webkit-details-marker]:hidden"
      >
        Oraciones
        <span aria-hidden="true" class="text-[8px] transition-transform duration-150 group-open:rotate-180">▾</span>
      </summary>
      <div class="absolute left-0 top-full z-30 mt-2 flex min-w-[230px] flex-col gap-1 bg-paper p-3 shadow-[0_18px_35px_rgba(12,38,53,0.12)] max-[900px]:static max-[900px]:mt-3 max-[900px]:w-full max-[900px]:bg-transparent max-[900px]:p-0 max-[900px]:shadow-none">
        {
          prayerLinks.map((link) => (
            <a
              href={link.href}
              class="block px-3 py-2 text-xs font-semibold uppercase tracking-[0.08em] text-[#536267] hover:text-gold"
            >
              {link.label}
            </a>
          ))
        }
      </div>
    </details>

    {
      linksAfter.map((link) => (
        <a
          href={link.href}
          class="group relative pb-2 text-xs font-semibold uppercase tracking-[0.08em] text-[#536267]"
        >
          {link.label}
          <span class="absolute inset-x-0 -bottom-2 h-px origin-left scale-x-0 bg-gold transition-transform duration-200 ease-out group-hover:scale-x-100" />
        </a>
      ))
    }
  </nav>
</header>

<script>
  const menuButton =
    document.querySelector<HTMLButtonElement>("[data-menu-button]");
  const navigation = document.querySelector<HTMLElement>("[data-menu]");

  menuButton?.addEventListener("click", () => {
    const isOpen = navigation?.toggleAttribute("data-open") ?? false;
    menuButton.setAttribute("aria-expanded", String(isOpen));
  });

  navigation?.querySelectorAll("a").forEach((link) =>
    link.addEventListener("click", () => {
      navigation.removeAttribute("data-open");
      menuButton?.setAttribute("aria-expanded", "false");
    }),
  );

  const oracionesDropdown = document.querySelector<HTMLDetailsElement>("[data-oraciones-dropdown]");

  oracionesDropdown?.querySelectorAll("a").forEach((link) =>
    link.addEventListener("click", () => {
      oracionesDropdown.removeAttribute("open");
    }),
  );

  document.addEventListener("click", (event) => {
    if (!oracionesDropdown?.open) return;
    if (!(event.target instanceof Node) || oracionesDropdown.contains(event.target)) return;
    oracionesDropdown.removeAttribute("open");
  });
</script>
