---
export const prerender = true;

import Layout from "@/layout/Layout.astro";
import { Leaf, ArrowRight } from "@lucide/astro";
import { Icon } from "astro-icon/components";

const datosEsenciales = [
  [
    "calendario",
    "Cuándo se celebra",
    "Comienza con la Vigilia Pascual y el Domingo de Resurrección. En 2026, el Domingo de Pascua será el 5 de abril y el tiempo pascual concluirá con Pentecostés, el 24 de mayo.",
  ],
  [
    "tiempo",
    "Cuánto dura aproximadamente",
    "Cincuenta días, desde el Domingo de Resurrección hasta Pentecostés.",
  ],
  [
    "color-liturgico",
    "Color litúrgico",
    "Blanco o dorado, signo de gloria, alegría y vida nueva. En Pentecostés se utiliza el rojo, símbolo del fuego del Espíritu Santo.",
  ],
  [
    "cirio-pascual",
    "Símbolo principal",
    "El cirio pascual, que representa a Cristo resucitado, luz del mundo.",
  ],
  [
    "sepulcro-vacio",
    "Qué acontecimiento contemplamos",
    "La Resurrección de Jesús, sus encuentros con los discípulos, la Ascensión y la venida del Espíritu Santo.",
  ],
  [
    "proposito-espiritual",
    "Qué nos invita a vivir",
    "La alegría, la esperanza, el testimonio y la renovación de nuestra vida.",
  ],
] as const;

const caminoEspiritual = [
  [
    "familia-y-casa",
    "Dejarse encontrar",
    "Jesús resucitado sale al encuentro de sus discípulos en medio del miedo, la tristeza y la incertidumbre.",
  ],
  [
    "camino-regreso",
    "Caminar con esperanza",
    "La Resurrección nos recuerda que ninguna noche es definitiva cuando dejamos que Dios entre en ella.",
  ],
  [
    "oracion-y-comunidad",
    "Convertirse en testigo",
    "Quien se encuentra con Cristo vivo recibe la misión de llevar consuelo, paz y esperanza a los demás.",
  ],
] as const;

const signos = [
  [
    "cirio-pascual",
    "El cirio pascual",
    "Representa a Cristo resucitado, cuya luz vence la oscuridad.",
  ],
  [
    "sepulcro-vacio",
    "El sepulcro vacío",
    "Anuncia que la muerte ha sido vencida y que Jesús está vivo.",
  ],
  [
    "agua",
    "El agua",
    "Recuerda el Bautismo y la vida nueva que recibimos en Cristo.",
  ],
  [
    "color-liturgico-blanco",
    "El color blanco",
    "Expresa la alegría, la gloria y la novedad de la Resurrección.",
  ],
  [
    "fuego",
    "El fuego",
    "Simboliza la presencia del Espíritu Santo, que ilumina, fortalece y envía.",
  ],
] as const;

const cotidiano = [
  [
    "vida-personal",
    "En tu vida personal",
    "Reconoce una situación en la que Dios te esté invitando a comenzar nuevamente.",
  ],
  [
    "familia-y-casa",
    "En casa o en familia",
    "Compartan durante la semana un motivo de alegría o gratitud y oren por quienes necesitan esperanza.",
  ],
  [
    "oracion-y-comunidad",
    "En la oración y la comunidad",
    "Renueva conscientemente tus promesas bautismales y participa con alegría en la vida de tu comunidad.",
  ],
] as const;
---

<Layout title="Pascua">
  <section
    id="inicio"
    class="relative flex min-h-[560px] items-center overflow-hidden px-[clamp(28px,8vw,130px)] pt-[150px] pb-[84px] text-white max-[900px]:min-h-[500px] max-[900px]:pt-[135px] max-[620px]:min-h-[720px] max-[620px]:px-[22px] max-[620px]:pt-[135px] max-[620px]:pb-[80px] bg-[url('/images/hero-pascua.webp')] bg-no-repeat bg-cover lg:bg-center bg-position-[75%_0]"
  >
    <div
      aria-hidden="true"
      class="absolute inset-0 z-[1] hidden bg-black/45 max-[620px]:block"
    >
    </div>
    <div
      aria-hidden="true"
      class="absolute inset-0 z-[1] block bg-linear-to-r from-black/30 to-transparent max-[620px]:hidden"
    >
    </div>

    <div class="relative z-[2] max-w-[710px]">
      <p
        class="mb-[26px] flex items-center gap-3 text-[11px] font-bold uppercase tracking-[0.2em] text-white/76"
      >
        <span class="h-px w-[34px] bg-gold"></span>
        Tiempo litúrgico
      </p>
      <h1
        class="m-0 font-serif text-[clamp(50px,6vw,82px)] leading-[1.05] tracking-[-0.045em] font-normal max-[620px]:text-[46px]"
      >
        <em class="font-normal not-italic text-[#e0c295]">Pascua</em>
      </h1>
      <p
        class="my-[28px] max-w-[550px] font-serif text-lg leading-[1.7] text-white/77 max-[620px]:text-base"
      >
        Un tiempo para celebrar la Resurrección y la vida nueva.
      </p>
    </div>
  </section>

  <section
    id="que-es"
    class="relative grid grid-cols-[0.85fr_1.15fr] gap-[70px] bg-paper px-[clamp(24px,7vw,110px)] py-[105px] max-[900px]:grid-cols-1 max-[620px]:px-5 max-[620px]:py-[74px]"
  >
    <div class="lg:sticky lg:top-45 h-max">
      <h2
        class="m-0 font-serif text-2xl font-normal tracking-[-0.02em] text-navy"
      >
        ¿Qué es la Pascua?
      </h2>
      <div aria-hidden="true" class="my-5 flex items-center gap-2 text-gold">
        <span class="h-px w-10 bg-gold/50"></span>
        <Leaf class="size-4" stroke-width={1.5} />
      </div>
      <p
        class="font-serif text-[clamp(24px,2.6vw,30px)] leading-[1.35] text-gold"
      >
        La Pascua es la celebración de la Resurrección de Jesús.
      </p>
    </div>

    <div
      class="grid grid-cols-3 gap-8 max-[900px]:grid-cols-1 max-[900px]:gap-6"
    >
      <p class="m-0 text-sm leading-[1.75] text-muted">
        La muerte no tuvo la última palabra: Cristo vive y abre para toda la
        humanidad un camino de esperanza y vida nueva.
      </p>
      <p class="m-0 text-sm leading-[1.75] text-muted">
        La alegría pascual no consiste en negar el dolor, sino en descubrir que
        el amor de Dios es más fuerte que toda oscuridad. Las heridas de Jesús
        permanecen, pero ahora son signos de un amor que ha vencido.
      </p>
      <p class="m-0 text-sm leading-[1.75] text-muted">
        Durante cincuenta días, la Iglesia celebra esta alegría y aprende a
        vivir como comunidad resucitada. El tiempo pascual culmina con
        Pentecostés, cuando el Espíritu Santo fortalece y envía a los
        discípulos.
      </p>
    </div>
  </section>

  <section
    id="datos-esenciales"
    class="bg-cream px-[clamp(24px,7vw,110px)] py-[105px] max-[620px]:px-5 max-[620px]:py-[74px]"
  >
    <div class="mb-12 text-center">
      <h2
        class="m-0 font-serif text-[clamp(28px,3vw,36px)] font-normal tracking-[-0.02em] text-navy"
      >
        Datos esenciales
      </h2>
      <div
        aria-hidden="true"
        class="mx-auto mt-4 flex w-24 items-center justify-center gap-2 text-gold"
      >
        <span class="h-px flex-1 bg-gold/40"></span>
        <Leaf class="size-4" stroke-width={1.5} />
        <span class="h-px flex-1 bg-gold/40"></span>
      </div>
    </div>
    <ul
      class="grid grid-cols-3 gap-6 max-[900px]:grid-cols-2 max-[620px]:grid-cols-1"
    >
      {
        datosEsenciales.map(([icon, title, text]) => (
          <li class="flex items-start gap-4 rounded-2xl border border-gold/15 bg-[#fdf6ea] p-6">
            <span class="flex size-12 flex-none items-center justify-center rounded-full bg-gold/15">
              <Icon name={icon} class="size-7/10" />
            </span>
            <div>
              <h3 class="m-0 mb-1 font-serif text-base font-semibold text-navy">
                {title}
              </h3>
              <p class="m-0 text-sm leading-[1.7] text-muted">{text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section
    id="camino-espiritual"
    class="px-[clamp(24px,7vw,110px)] py-[105px] max-[620px]:px-5 max-[620px]:py-[74px] bg-navy"
  >
    <div class="mb-14 text-center">
      <h2
        class="m-0 font-serif text-[clamp(28px,3vw,36px)] font-normal tracking-[-0.02em] text-gold"
      >
        El camino espiritual
      </h2>
      <div
        aria-hidden="true"
        class="mx-auto mt-4 flex w-24 items-center justify-center gap-2 text-gold"
      >
        <span class="h-px flex-1 bg-gold/50"></span>
        <Leaf class="size-4" stroke-width={1.5} />
        <span class="h-px flex-1 bg-gold/50"></span>
      </div>
    </div>

    <div class="flex items-start gap-0 max-[900px]:flex-col max-[900px]:gap-8">
      {
        caminoEspiritual.map(([icon, title, text], index) => (
          <div class="flex flex-1 items-center gap-4 max-[900px]:w-full">
            <div class="flex-1 rounded-2xl border border-gold/25 bg-paper p-8 text-center">
              <span class="relative mx-auto mb-5 flex size-16 items-center justify-center rounded-full border-2 border-gold/50 bg-[#fbf1de]">
                <Icon name={icon} class="size-7/10" />
                <span class="absolute -left-1.5 -top-1.5 flex size-6 items-center justify-center rounded-full bg-gold font-serif text-[11px] font-semibold text-white">
                  {String(index + 1).padStart(2, "0")}
                </span>
              </span>
              <h3 class="m-0 mb-2 font-serif text-xl font-medium text-navy">
                {title}
              </h3>
              <p class="m-0 text-sm leading-[1.7] text-muted">{text}</p>
            </div>
            {index < caminoEspiritual.length - 1 && (
              <ArrowRight
                aria-hidden="true"
                stroke-width={1.5}
                class="size-5 flex-none text-gold/70 max-[900px]:hidden"
              />
            )}
          </div>
        ))
      }
    </div>
  </section>

  <section
    id="signos"
    class="bg-paper px-[clamp(24px,7vw,110px)] py-[105px] max-[620px]:px-5 max-[620px]:py-[74px]"
  >
    <div class="mb-12 text-center">
      <h2
        class="m-0 font-serif text-[clamp(28px,3vw,36px)] font-normal tracking-[-0.02em] text-navy"
      >
        Signos y símbolos
      </h2>
      <div
        aria-hidden="true"
        class="mx-auto mt-4 flex w-24 items-center justify-center gap-2 text-gold"
      >
        <span class="h-px flex-1 bg-gold/40"></span>
        <Leaf class="size-4" stroke-width={1.5} />
        <span class="h-px flex-1 bg-gold/40"></span>
      </div>
    </div>
    <div
      class="grid grid-cols-5 gap-6 max-[900px]:grid-cols-2 max-[620px]:grid-cols-1"
    >
      {
        signos.map(([icon, title, text]) => (
          <div class="rounded-2xl border border-gold/15 bg-[#fdf6ea] p-6 text-center">
            <span class="mx-auto mb-4 flex size-14 items-center justify-center rounded-full bg-gold/15">
              <Icon name={icon} class="size-7/10" />
            </span>
            <h3 class="m-0 mb-2 font-serif text-lg font-medium text-navy">
              {title}
            </h3>
            <p class="m-0 text-sm leading-[1.7] text-muted">{text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section
    id="cita"
    class="flex min-h-[280px] items-center justify-center bg-navy px-[clamp(24px,7vw,110px)] py-[90px] text-center max-[620px]:px-5 max-[620px]:py-[64px]"
  >
    <div class="max-w-[720px]">
      <p
        class="mb-[26px] flex items-center justify-center gap-3 text-[11px] font-bold uppercase tracking-[0.2em] text-gold"
      >
        <span class="h-px w-[34px] bg-gold"></span>
        Una Palabra para acompañarte
        <span class="h-px w-[34px] bg-gold"></span>
      </p>
      <p
        class="font-serif text-[clamp(26px,3.4vw,38px)] italic leading-[1.4] tracking-[-0.01em] text-white"
      >
        «No está aquí, porque ha resucitado, como lo había dicho.»
      </p>
      <p
        class="mt-5 text-[11px] font-bold uppercase tracking-[0.2em] text-gold"
      >
        Mateo 28, 6
      </p>
    </div>
  </section>

  <section
    id="cotidiano"
    class="bg-paper px-[clamp(24px,7vw,110px)] py-[105px] max-[620px]:px-5 max-[620px]:py-[74px]"
  >
    <div class="mb-12 text-center">
      <h2
        class="m-0 font-serif text-[clamp(28px,3vw,36px)] font-normal tracking-[-0.02em] text-navy"
      >
        Cómo vivirlo en lo cotidiano
      </h2>
      <div
        aria-hidden="true"
        class="mx-auto mt-4 flex w-24 items-center justify-center gap-2 text-gold"
      >
        <span class="h-px flex-1 bg-gold/40"></span>
        <Leaf class="size-4" stroke-width={1.5} />
        <span class="h-px flex-1 bg-gold/40"></span>
      </div>
    </div>
    <div class="grid grid-cols-3 gap-6 max-[900px]:grid-cols-1">
      {
        cotidiano.map(([icon, title, text]) => (
          <div class="flex items-start gap-4 rounded-2xl border border-gold/15 bg-[#fdf6ea] p-6">
            <span class="flex size-12 flex-none items-center justify-center rounded-full bg-gold/15">
              <Icon name={icon} class="size-7/10" />
            </span>
            <div>
              <h3 class="m-0 mb-1 font-serif text-base font-semibold text-navy">
                {title}
              </h3>
              <p class="m-0 text-sm leading-[1.7] text-muted">{text}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section
    id="oracion-breve"
    class="grid items-center gap-[clamp(50px,8vw,100px)] px-[clamp(24px,7vw,110px)] py-[105px] max-[900px]:grid-cols-1 max-[620px]:px-5 max-[620px]:py-[74px] grid-cols-[0.9fr_1.1fr]"
    style="background: radial-gradient(circle at 85% 15%, rgba(200,163,106,.18), transparent 45%), #f7f1e4;"
  >
    <div
      class="overflow-hidden rounded-2xl shadow-[0_20px_60px_rgba(120,90,40,0.18)]"
    >
      <img
        src="/images/hero-pascua.webp"
        alt=""
        class="h-full w-full object-cover"
        loading="lazy"
      />
    </div>

    <div>
      <h2
        class="m-0 font-serif text-[clamp(28px,3vw,36px)] font-normal tracking-[-0.02em] text-navy"
      >
        Oración breve
      </h2>
      <div aria-hidden="true" class="my-5 flex items-center gap-2 text-gold">
        <span class="h-px w-10 bg-gold/50"></span>
        <Leaf class="size-4" stroke-width={1.5} />
      </div>
      <p
        class="max-w-[480px] font-serif text-lg italic leading-[1.8] text-muted"
      >
        Jesús resucitado,<br />
        entra en mis temores y lléname de tu paz.<br />
        Hazme reconocer los signos de vida nueva<br />
        que ya estás despertando<br />
        en mi corazón y a mi alrededor.<br />
        Espíritu Santo, enciende mi fe,<br />
        y María, Madre de la esperanza,<br />
        enséñame a anunciar que Jesús vive.<br />
        Amén.
      </p>
    </div>
  </section>
</Layout>
