---
export const prerender = true;

import Layout from "@/layout/Layout.astro";
import { CalendarDays, Hourglass, Palette, Flame, Mountain, Heart, Eye, HandMetal, HeartHandshake, Wind, Cross, Footprints, Leaf, User, House, HandHeart, ArrowRight } from "@lucide/astro";

const datosEsenciales = [
  [
    CalendarDays,
    "Cuándo se celebra",
    "Comienza el Miércoles de Ceniza, que en 2026 será el 18 de febrero, y continúa hasta antes de la Misa de la Cena del Señor del Jueves Santo.",
  ],
  [
    Hourglass,
    "Cuánto dura aproximadamente",
    "Cuarenta días, sin contar los domingos en el cómputo penitencial tradicional.",
  ],
  [
    Palette,
    "Color litúrgico",
    "Morado, signo de conversión, sobriedad y preparación. El cuarto domingo puede utilizarse el color rosa, como señal de esperanza y cercanía de la Pascua.",
  ],
  [
    Flame,
    "Símbolo principal",
    "La ceniza, que recuerda nuestra fragilidad y la necesidad de volver a Dios.",
  ],
  [
    Mountain,
    "Qué acontecimiento contemplamos",
    "El camino de Jesús hacia Jerusalén y su entrega por amor.",
  ],
  [
    Heart,
    "Qué nos invita a vivir",
    "La conversión del corazón mediante la oración, el ayuno y la caridad.",
  ],
] as const;

const caminoEspiritual = [
  [
    Eye,
    "Reconocer con sinceridad",
    "La conversión comienza cuando dejamos de justificarnos y permitimos que Dios ilumine nuestra realidad.",
  ],
  [
    HandMetal,
    "Soltar lo que nos aleja",
    "El ayuno no consiste solamente en dejar alimentos. También podemos ayunar de palabras dañinas, rencores, excesos y actitudes que lastiman.",
  ],
  [
    HeartHandshake,
    "Volver a amar",
    "Toda práctica cuaresmal debe ayudarnos a amar mejor a Dios y a las personas que ha puesto en nuestro camino.",
  ],
] as const;

const signos = [
  [
    Flame,
    "La ceniza",
    "Nos recuerda que somos frágiles y necesitamos continuamente la misericordia de Dios.",
  ],
  [
    Wind,
    "El desierto",
    "Representa el silencio, la prueba y el lugar interior donde aprendemos a escuchar lo verdaderamente importante.",
  ],
  [
    Palette,
    "El color morado",
    "Invita a la sobriedad, el arrepentimiento y la preparación espiritual.",
  ],
  [
    Cross,
    "La cruz",
    "Nos muestra el amor de Jesús, que permanece fiel y se entrega completamente.",
  ],
  [
    Footprints,
    "El camino de regreso",
    "Expresa la conversión como el regreso confiado de un hijo hacia el Padre.",
  ],
] as const;

const cotidiano = [
  [
    User,
    "En tu vida personal",
    "Identifica una actitud que necesite cambiar y trabaja en ella con paciencia durante este tiempo.",
  ],
  [
    House,
    "En casa o en familia",
    "Elijan una forma de compartir con quienes tienen menos: alimentos, ropa, tiempo o ayuda concreta.",
  ],
  [
    HandHeart,
    "En la oración y la comunidad",
    "Participa en la Reconciliación, medita el camino de la cruz y reserva un momento diario para hablar con Dios.",
  ],
] as const;
---

<Layout title="Cuaresma">
  <section
    id="inicio"
    class="relative flex min-h-[560px] items-center overflow-hidden px-[clamp(28px,8vw,130px)] pt-[150px] pb-[84px] text-white max-[900px]:min-h-[500px] max-[900px]:pt-[135px] max-[620px]:min-h-[720px] max-[620px]:px-[22px] max-[620px]:pt-[135px] max-[620px]:pb-[80px] bg-[url('/images/hero-cuaresma.webp')] bg-no-repeat bg-cover lg:bg-center bg-position-[75%_0]"
  >
    <div aria-hidden="true" class="absolute inset-0 z-[1] hidden bg-black/45 max-[620px]:block"></div>

    <div class="relative z-[2] max-w-[710px]">
      <p class="mb-[26px] flex items-center gap-3 text-[11px] font-bold uppercase tracking-[0.2em] text-white/76">
        <span class="h-px w-[34px] bg-gold"></span>
        Tiempo litúrgico
      </p>
      <h1 class="m-0 font-serif text-[clamp(50px,6vw,82px)] leading-[1.05] tracking-[-0.045em] font-normal max-[620px]:text-[46px]">
        <em class="font-normal not-italic text-[#e0c295]">Cuaresma</em>
      </h1>
      <p class="my-[28px] max-w-[550px] font-serif text-lg leading-[1.7] text-white/77 max-[620px]:text-base">
        Un tiempo para volver el corazón a Dios.
      </p>
    </div>
  </section>

  <section
    id="que-es"
    class="relative grid grid-cols-[0.85fr_1.15fr] gap-[70px] bg-paper px-[clamp(24px,7vw,110px)] py-[105px] max-[900px]:grid-cols-1 max-[620px]:px-5 max-[620px]:py-[74px]"
  >
    <div class="lg:sticky lg:top-45 h-max">
      <h2 class="m-0 font-serif text-2xl font-normal tracking-[-0.02em] text-navy">
        ¿Qué es la Cuaresma?
      </h2>
      <div aria-hidden="true" class="my-5 flex items-center gap-2 text-gold">
        <span class="h-px w-10 bg-gold/50"></span>
        <Leaf class="size-4" stroke-width={1.5} />
      </div>
      <p class="font-serif text-[clamp(24px,2.6vw,30px)] leading-[1.35] text-[#5c2f66]">
        La Cuaresma es un camino de cuarenta días que prepara a la Iglesia para celebrar la Pascua.
      </p>
    </div>

    <div class="grid grid-cols-3 gap-8 max-[900px]:grid-cols-1 max-[900px]:gap-6">
      <p class="m-0 text-sm leading-[1.75] text-muted">
        Comienza con el Miércoles de Ceniza y nos conduce hacia los días
        santos de la Pasión, Muerte y Resurrección de Jesús.
      </p>
      <p class="m-0 text-sm leading-[1.75] text-muted">
        Es un tiempo para detenernos y mirar con sinceridad nuestra vida. No
        busca llenarnos de culpa, sino ayudarnos a reconocer aquello que
        necesita cambiar, ser sanado o regresar a Dios.
      </p>
      <p class="m-0 text-sm leading-[1.75] text-muted">
        A través de la oración, el ayuno y la caridad, aprendemos a dejar lo
        que endurece el corazón y a recuperar lo esencial: nuestra relación
        con Dios y nuestro amor por los demás.
      </p>
    </div>
  </section>

  <section
    id="datos-esenciales"
    class="bg-cream px-[clamp(24px,7vw,110px)] py-[105px] max-[620px]:px-5 max-[620px]:py-[74px]"
  >
    <div class="mb-12 text-center">
      <h2 class="m-0 font-serif text-[clamp(28px,3vw,36px)] font-normal tracking-[-0.02em] text-navy">
        Datos esenciales
      </h2>
      <div aria-hidden="true" class="mx-auto mt-4 flex w-24 items-center justify-center gap-2 text-gold">
        <span class="h-px flex-1 bg-gold/40"></span>
        <Leaf class="size-4" stroke-width={1.5} />
        <span class="h-px flex-1 bg-gold/40"></span>
      </div>
    </div>
    <ul class="grid grid-cols-3 gap-6 max-[900px]:grid-cols-2 max-[620px]:grid-cols-1">
      {
        datosEsenciales.map(([IconComponent, title, text]) => (
          <li class="flex items-start gap-4 rounded-2xl border border-[#dcc5e3] bg-paper p-6">
            <span class="flex size-12 flex-none items-center justify-center rounded-full bg-[#f0e4f3]">
              <IconComponent stroke-width={1.5} class="size-6 text-[#5c2f66]" />
            </span>
            <div>
              <h3 class="m-0 mb-1 font-serif text-base font-semibold text-navy">{title}</h3>
              <p class="m-0 text-sm leading-[1.7] text-muted">{text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section
    id="camino-espiritual"
    class="px-[clamp(24px,7vw,110px)] py-[105px] max-[620px]:px-5 max-[620px]:py-[74px] bg-[#3c1e43]"
  >
    <div class="mb-14 text-center">
      <h2 class="m-0 font-serif text-[clamp(28px,3vw,36px)] font-normal tracking-[-0.02em] text-gold">
        El camino espiritual
      </h2>
      <div aria-hidden="true" class="mx-auto mt-4 flex w-24 items-center justify-center gap-2 text-gold">
        <span class="h-px flex-1 bg-gold/50"></span>
        <Leaf class="size-4" stroke-width={1.5} />
        <span class="h-px flex-1 bg-gold/50"></span>
      </div>
    </div>

    <div class="flex items-start gap-0 max-[900px]:flex-col max-[900px]:gap-8">
      {
        caminoEspiritual.map(([IconComponent, title, text], index) => (
          <div class="flex flex-1 items-center gap-4 max-[900px]:w-full">
            <div class="flex-1 rounded-2xl border border-[#8a5395]/40 bg-paper p-8 text-center">
              <span class="relative mx-auto mb-5 flex size-16 items-center justify-center rounded-full border-2 border-[#5c2f66]/50 bg-[#f0e4f3]">
                <IconComponent stroke-width={1.5} class="size-7 text-[#5c2f66]" />
                <span class="absolute -left-1.5 -top-1.5 flex size-6 items-center justify-center rounded-full bg-[#3c1e43] font-serif text-[11px] font-semibold text-white">
                  {String(index + 1).padStart(2, "0")}
                </span>
              </span>
              <h3 class="m-0 mb-2 font-serif text-xl font-medium text-navy">{title}</h3>
              <p class="m-0 text-sm leading-[1.7] text-muted">{text}</p>
            </div>
            {index < caminoEspiritual.length - 1 && (
              <ArrowRight aria-hidden="true" stroke-width={1.5} class="size-5 flex-none text-[#5c2f66]/70 max-[900px]:hidden" />
            )}
          </div>
        ))
      }
    </div>
  </section>

  <section
    id="signos"
    class="bg-paper px-[clamp(24px,7vw,110px)] py-[105px] max-[620px]:px-5 max-[620px]:py-[74px]"
  >
    <div class="mb-12 text-center">
      <h2 class="m-0 font-serif text-[clamp(28px,3vw,36px)] font-normal tracking-[-0.02em] text-navy">
        Signos y símbolos
      </h2>
      <div aria-hidden="true" class="mx-auto mt-4 flex w-24 items-center justify-center gap-2 text-gold">
        <span class="h-px flex-1 bg-gold/40"></span>
        <Leaf class="size-4" stroke-width={1.5} />
        <span class="h-px flex-1 bg-gold/40"></span>
      </div>
    </div>
    <div class="grid grid-cols-5 gap-6 max-[900px]:grid-cols-2 max-[620px]:grid-cols-1">
      {
        signos.map(([IconComponent, title, text]) => (
          <div class="rounded-2xl border border-[#dcc5e3] bg-[#f9f3fb] p-6 text-center">
            <span class="mx-auto mb-4 flex size-14 items-center justify-center rounded-full bg-[#f0e4f3]">
              <IconComponent stroke-width={1.5} class="size-7 text-[#5c2f66]" />
            </span>
            <h3 class="m-0 mb-2 font-serif text-lg font-medium text-navy">{title}</h3>
            <p class="m-0 text-sm leading-[1.7] text-muted">{text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section
    id="cita"
    class="flex min-h-[280px] items-center justify-center px-[clamp(24px,7vw,110px)] py-[90px] text-center max-[620px]:px-5 max-[620px]:py-[64px]"
    style="background: #3c1e43;"
  >
    <div class="max-w-[720px]">
      <p class="mb-[26px] flex items-center justify-center gap-3 text-[11px] font-bold uppercase tracking-[0.2em] text-gold">
        <span class="h-px w-[34px] bg-gold"></span>
        Una Palabra para acompañarte
        <span class="h-px w-[34px] bg-gold"></span>
      </p>
      <p class="font-serif text-[clamp(26px,3.4vw,38px)] italic leading-[1.4] tracking-[-0.01em] text-white">
        «Conviértanse y crean en el Evangelio.»
      </p>
      <p class="mt-5 text-[11px] font-bold uppercase tracking-[0.2em] text-gold">
        Marcos 1, 15
      </p>
    </div>
  </section>

  <section
    id="cotidiano"
    class="bg-paper px-[clamp(24px,7vw,110px)] py-[105px] max-[620px]:px-5 max-[620px]:py-[74px]"
  >
    <div class="mb-12 text-center">
      <h2 class="m-0 font-serif text-[clamp(28px,3vw,36px)] font-normal tracking-[-0.02em] text-navy">
        Cómo vivirlo en lo cotidiano
      </h2>
      <div aria-hidden="true" class="mx-auto mt-4 flex w-24 items-center justify-center gap-2 text-gold">
        <span class="h-px flex-1 bg-gold/40"></span>
        <Leaf class="size-4" stroke-width={1.5} />
        <span class="h-px flex-1 bg-gold/40"></span>
      </div>
    </div>
    <div class="grid grid-cols-3 gap-6 max-[900px]:grid-cols-1">
      {
        cotidiano.map(([IconComponent, title, text]) => (
          <div class="flex items-start gap-4 rounded-2xl border border-[#dcc5e3] bg-[#f9f3fb] p-6">
            <span class="flex size-12 flex-none items-center justify-center rounded-full bg-[#f0e4f3]">
              <IconComponent stroke-width={1.5} class="size-6 text-[#5c2f66]" />
            </span>
            <div>
              <h3 class="m-0 mb-1 font-serif text-base font-semibold text-navy">{title}</h3>
              <p class="m-0 text-sm leading-[1.7] text-muted">{text}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section
    id="oracion-breve"
    class="grid items-center gap-[clamp(50px,8vw,100px)] px-[clamp(24px,7vw,110px)] py-[105px] max-[900px]:grid-cols-1 max-[620px]:px-5 max-[620px]:py-[74px] grid-cols-[0.9fr_1.1fr]"
    style="background: radial-gradient(circle at 85% 15%, rgba(92,47,102,.18), transparent 45%), #f7f1e4;"
  >
    <div class="overflow-hidden rounded-2xl shadow-[0_20px_60px_rgba(60,30,67,0.18)]">
      <img src="/images/hero-cuaresma.webp" alt="" class="h-full w-full object-cover" loading="lazy" />
    </div>

    <div>
      <h2 class="m-0 font-serif text-[clamp(28px,3vw,36px)] font-normal tracking-[-0.02em] text-navy">
        Oración breve
      </h2>
      <div aria-hidden="true" class="my-5 flex items-center gap-2 text-gold">
        <span class="h-px w-10 bg-gold/50"></span>
        <Leaf class="size-4" stroke-width={1.5} />
      </div>
      <p class="max-w-[480px] font-serif text-lg italic leading-[1.8] text-muted">
        Padre misericordioso,<br />
        muéstrame aquello que necesita cambiar<br />
        y dame humildad para volver a ti.<br />
        Jesús, acompáñame por este camino.<br />
        Enséñame a orar, a renunciar con libertad<br />
        y a servir con un amor más verdadero.<br />
        Espíritu Santo, renueva mi corazón,<br />
        y María, permanece a mi lado<br />
        mientras aprendo a seguir a tu Hijo.<br />
        Amén.
      </p>
    </div>
  </section>
</Layout>
