---
export const prerender = false;

import { desc } from "drizzle-orm";
import DashboardLayout from "@/layout/DashboardLayout.astro";
import { db } from "@/db/client";
import { dailyPrayers } from "@/db/schema";

const prayers = await db.select().from(dailyPrayers).orderBy(desc(dailyPrayers.date));

const dateFormatter = new Intl.DateTimeFormat("es-ES", { dateStyle: "long" });

function formatDate(value: string) {
  const parsed = new Date(`${value}T00:00:00`);
  return Number.isNaN(parsed.getTime()) ? value : dateFormatter.format(parsed);
}

const error = Astro.url.searchParams.get("error");
const success = Astro.url.searchParams.has("success");
---

<DashboardLayout title="Oración del día" active="oracion">
  <div class="flex items-start justify-between gap-6">
    <div>
      <p class="m-0 flex items-center gap-3 text-[11px] font-bold uppercase tracking-[0.2em] text-blue">
        <span class="h-px w-[34px] bg-gold"></span>
        Panel privado
      </p>
      <h1 class="m-0 mt-3 font-serif text-3xl font-normal text-navy">Oración del día</h1>
    </div>
    <button
      type="button"
      data-open-dialog
      class="flex min-h-[44px] shrink-0 items-center justify-center gap-2 rounded-[2px] bg-gold px-5 text-[11px] font-bold uppercase tracking-[0.1em] text-white transition-transform duration-150 hover:-translate-y-0.5"
    >
      + Nueva oración
    </button>
  </div>

  {
    success && (
      <p class="mt-6 border border-green-200 bg-green-50 p-3 text-sm text-green-700">
        Oración guardada correctamente.
      </p>
    )
  }
  {
    error === "duplicate" && (
      <p class="mt-6 border border-red-200 bg-red-50 p-3 text-sm text-red-700">
        Ya existe una oración guardada para esa fecha.
      </p>
    )
  }
  {
    error === "missing" && (
      <p class="mt-6 border border-red-200 bg-red-50 p-3 text-sm text-red-700">
        Completa los campos obligatorios: fecha, título y descripción.
      </p>
    )
  }

  <div class="mt-8 overflow-x-auto">
    <table class="w-full border-collapse text-left text-sm">
      <thead>
        <tr class="border-b border-line text-[10px] uppercase tracking-[0.12em] text-muted">
          <th class="py-3 pr-4 font-bold">Fecha</th>
          <th class="py-3 pr-4 font-bold">Slug</th>
          <th class="py-3 pr-4 font-bold">Título</th>
          <th class="py-3 pr-4 font-bold">Subtítulo</th>
          <th class="py-3 pr-4 font-bold">Fuente</th>
        </tr>
      </thead>
      <tbody>
        {
          prayers.length === 0 && (
            <tr>
              <td colspan="5" class="py-16 text-center text-muted">
                Todavía no hay oraciones cargadas.
              </td>
            </tr>
          )
        }
        {
          prayers.map((prayer) => (
            <tr class="border-b border-line align-top">
              <td class="py-4 pr-4 text-xs whitespace-nowrap text-muted">{formatDate(prayer.date)}</td>
              <td class="py-4 pr-4 text-xs whitespace-nowrap text-muted">
                <a href={`/oracion-del-dia/${prayer.slug}`} target="_blank" rel="noreferrer" class="text-blue hover:text-gold">
                  {prayer.slug}
                </a>
              </td>
              <td class="py-4 pr-4 font-serif text-base text-navy">{prayer.title}</td>
              <td class="py-4 pr-4 text-xs text-muted">{prayer.subtitle || "—"}</td>
              <td class="py-4 pr-4 text-xs text-muted">{prayer.source || "—"}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <dialog
    data-dialog
    class="m-auto w-full max-w-lg border border-line bg-paper p-0 shadow-[0_18px_60px_rgba(28,56,67,0.15)] backdrop:bg-navy/40"
  >
    <form method="POST" action="/api/admin/oracion-del-dia" class="p-8">
      <div class="mb-6 flex items-center justify-between">
        <h2 class="m-0 font-serif text-2xl font-normal text-navy">Nueva oración</h2>
        <button
          type="button"
          data-close-dialog
          aria-label="Cerrar"
          class="border-0 bg-transparent text-xl text-muted"
        >
          ×
        </button>
      </div>

      <label class="mb-5 block text-[10px] font-bold uppercase tracking-[0.1em] text-navy">
        Fecha
        <input
          name="date"
          type="date"
          required
          class="mt-[9px] block w-full border border-line bg-[#fbf8f2] p-[14px] text-sm normal-case text-ink outline-none focus:border-gold"
        />
      </label>
      <label class="mb-5 block text-[10px] font-bold uppercase tracking-[0.1em] text-navy">
        Título
        <input
          name="title"
          required
          class="mt-[9px] block w-full border border-line bg-[#fbf8f2] p-[14px] text-sm normal-case text-ink outline-none focus:border-gold"
        />
      </label>
      <label class="mb-5 block text-[10px] font-bold uppercase tracking-[0.1em] text-navy">
        Subtítulo <span class="text-[8px] font-medium tracking-normal text-[#a5acad] normal-case">(opcional)</span>
        <input
          name="subtitle"
          class="mt-[9px] block w-full border border-line bg-[#fbf8f2] p-[14px] text-sm normal-case text-ink outline-none focus:border-gold"
        />
      </label>
      <label class="mb-5 block text-[10px] font-bold uppercase tracking-[0.1em] text-navy">
        Descripción
        <textarea
          name="description"
          required
          rows="5"
          class="mt-[9px] block w-full resize-y border border-line bg-[#fbf8f2] p-[14px] text-sm normal-case text-ink outline-none focus:border-gold"
        ></textarea>
      </label>
      <label class="mb-6 block text-[10px] font-bold uppercase tracking-[0.1em] text-navy">
        Fuente <span class="text-[8px] font-medium tracking-normal text-[#a5acad] normal-case">(opcional)</span>
        <input
          name="source"
          placeholder="Ej. Salmo 119, 105"
          class="mt-[9px] block w-full border border-line bg-[#fbf8f2] p-[14px] text-sm normal-case text-ink outline-none focus:border-gold"
        />
      </label>

      <button
        type="submit"
        class="flex min-h-[52px] w-full items-center justify-center gap-[10px] rounded-[2px] bg-gold px-[25px] text-[11px] font-bold uppercase tracking-[0.1em] text-white transition-transform duration-150 hover:-translate-y-0.5"
      >
        Guardar oración
      </button>
    </form>
  </dialog>
</DashboardLayout>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-dialog]");

  document.querySelector("[data-open-dialog]")?.addEventListener("click", () => dialog?.showModal());
  document.querySelector("[data-close-dialog]")?.addEventListener("click", () => dialog?.close());
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>
