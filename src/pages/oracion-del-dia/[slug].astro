---
export const prerender = false;

import { eq } from "drizzle-orm";
import Layout from "@/layout/Layout.astro";
import DailyPrayerView from "@/components/DailyPrayerView.astro";
import { db } from "@/db/client";
import { dailyPrayers } from "@/db/schema";
import { slugToIso } from "@/lib/dates";

const { slug } = Astro.params;
const date = slug ? slugToIso(slug) : null;

if (!date) {
  return Astro.redirect("/oracion-del-dia");
}

const [prayer] = await db.select().from(dailyPrayers).where(eq(dailyPrayers.date, date)).limit(1);
---

<Layout title="Oración del día">
  <DailyPrayerView date={date} prayer={prayer ?? null} />
</Layout>
