---
export const prerender = true;

import Layout from "@/layout/Layout.astro";
import { CalendarDays, Hourglass, Palette, Flame, Star, Heart } from "@lucide/astro";

const datosEsenciales = [
  [
    CalendarDays,
    "Cuándo se celebra",
    "Comienza cuatro domingos antes de Navidad y termina antes de la celebración de la Natividad del Señor. En el ciclo 2025–2026 comienza el domingo 30 de noviembre de 2025 y concluye el 24 de diciembre de 2025.",
  ],
  [Hourglass, "Cuánto dura aproximadamente", "Alrededor de cuatro semanas."],
  [
    Palette,
    "Color litúrgico",
    "Morado, como signo de preparación, recogimiento y conversión. En el tercer domingo puede utilizarse el color rosa, signo de alegría porque la Navidad está cerca.",
  ],
  [
    Flame,
    "Símbolo principal",
    "La corona de Adviento, con sus cuatro velas que se encienden progresivamente.",
  ],
  [
    Star,
    "Qué acontecimiento contemplamos",
    "La espera del nacimiento de Jesús y la promesa de su venida definitiva.",
  ],
  [
    Heart,
    "Qué nos invita a vivir",
    "Una esperanza activa: esperar a Dios mientras preparamos el corazón para reconocerlo y recibirlo.",
  ],
] as const;

const caminoEspiritual = [
  [
    "Esperar con confianza",
    "No todas las respuestas llegan de inmediato. El Adviento nos enseña a confiar en que Dios sigue actuando, incluso cuando todavía no podemos ver con claridad.",
  ],
  [
    "Preparar el corazón",
    "Prepararnos significa revisar nuestra vida, reconciliarnos, soltar lo que nos aleja de Dios y abrirle un espacio verdadero.",
  ],
  [
    "Reconocer su presencia",
    "Jesús también viene en lo pequeño: en una conversación, en una necesidad, en un momento de silencio, en una persona que necesita ser escuchada.",
  ],
];

const signos = [
  [
    "La corona de Adviento",
    "Su forma circular recuerda el amor de Dios, que no tiene principio ni fin. Sus ramas verdes expresan vida y esperanza.",
  ],
  ["Las velas", "Se enciende una cada domingo. Su luz creciente anuncia que Cristo está cada vez más cerca."],
  ["El color morado", "Nos invita al recogimiento, a la oración y a preparar interiormente el camino del Señor."],
  ["La luz", "Representa a Jesús, que llega para iluminar nuestras oscuridades y mostrarnos un camino nuevo."],
  [
    "El camino",
    "Nos recuerda que esperar a Dios también significa avanzar, convertirnos y orientar nuevamente nuestros pasos hacia Él.",
  ],
];

const cotidiano = [
  [
    "En tu vida personal",
    "Reserva cada día unos minutos de silencio. Pregúntate qué necesita ser ordenado, sanado o entregado a Dios.",
  ],
  [
    "En casa o en familia",
    "Enciendan semanalmente las velas de la corona de Adviento y compartan una intención de oración.",
  ],
  [
    "En la oración y la comunidad",
    "Acércate al sacramento de la Reconciliación y realiza una obra concreta de misericordia.",
  ],
];
---

<Layout title="Adviento">
  <section
    id="inicio"
    class="relative flex min-h-[560px] items-center overflow-hidden px-[clamp(28px,8vw,130px)] pt-[150px] pb-[84px] text-white max-[900px]:min-h-[500px] max-[900px]:pt-[135px] max-[620px]:min-h-[720px] max-[620px]:px-[22px] max-[620px]:pt-[135px] max-[620px]:pb-[80px] bg-[url('/images/hero-adviento.webp')] bg-no-repeat bg-cover lg:bg-center bg-position-[80%_0]"
  >
  <div aria-hidden="true" class="absolute inset-0 z-[1] hidden bg-black/45 max-[620px]:block"></div>

  
    <div class="relative z-[2] max-w-[710px]">
      <p class="mb-[26px] flex items-center gap-3 text-[11px] font-bold uppercase tracking-[0.2em] text-white/76">
        <span class="h-px w-[34px] bg-gold"></span>
        Tiempo litúrgico
      </p>
      <h1 class="m-0 font-serif text-[clamp(50px,6vw,82px)] leading-[1.05] tracking-[-0.045em] font-normal max-[620px]:text-[46px]">
        <em class="font-normal not-italic text-[#e0c295]">Adviento</em>
      </h1>
      <p class="my-[28px] max-w-[550px] font-serif text-lg leading-[1.7] text-white/77 max-[620px]:text-base">
        Un tiempo para esperar y preparar el corazón.
      </p>
    </div>
  </section>

  <section
    id="que-es"
    class="relative grid grid-cols-[0.85fr_1.15fr] gap-[70px] bg-paper px-[clamp(24px,7vw,110px)] py-[105px] max-[900px]:grid-cols-1 max-[620px]:px-5 max-[620px]:py-[74px]"
  >
    <div class="lg:sticky lg:top-45 h-max">
      <p class="mb-[26px] flex items-center gap-3 text-[11px] font-bold uppercase tracking-[0.2em] text-blue">
        <span class="h-px w-[34px] bg-gold"></span>
        ¿Qué es el Adviento?
      </p>
      <h2 class="m-0 font-serif text-[clamp(32px,4vw,44px)] leading-[1.15] font-normal tracking-[-0.03em] text-navy">
        El Adviento es el tiempo con el que comienza un nuevo Año Litúrgico.
      </h2>
    </div>

    <div class="max-w-[620px] font-serif text-lg leading-[1.75] text-muted [&_p+p]:mt-5">
      <p>
        Durante estas semanas, la Iglesia nos invita a detenernos, despertar el
        corazón y prepararnos para recibir a Jesús.
      </p>
      <p>
        No se trata solamente de esperar la celebración de la Navidad. El
        Adviento también nos recuerda que Cristo viene cada día a nuestra vida
        y que un día volverá plenamente. Por eso, es un tiempo de esperanza,
        vigilancia y confianza.
      </p>
      <p>
        Mientras el mundo se llena de prisas, luces y preparativos, la Iglesia
        nos propone un camino interior: hacer silencio, ordenar lo que
        llevamos dentro y abrir un espacio para que Dios pueda habitar en
        nosotros.
      </p>
    </div>
  </section>

  <section
    id="datos-esenciales"
    class="bg-cream px-[clamp(24px,7vw,110px)] py-[105px] max-[620px]:px-5 max-[620px]:py-[74px]"
  >
    <p class="mb-[26px] flex items-center gap-3 text-[11px] font-bold uppercase tracking-[0.2em] text-blue">
      <span class="h-px w-[34px] bg-gold"></span>
      Datos esenciales
    </p>
    <ul class="grid grid-cols-3 gap-6 max-[900px]:grid-cols-2 max-[620px]:grid-cols-1">
      {
        datosEsenciales.map(([IconComponent, title, text]) => (
          <li class="bg-paper p-7 shadow-[0_18px_45px_rgba(21,48,61,0.06)] border-t-2 border-t-blue">
            <IconComponent stroke-width={1.5} class="mb-4 size-10 text-gold" />
            <h3 class="m-0 mb-3 font-serif text-lg font-medium text-navy">{title}</h3>
            <p class="m-0 text-sm leading-[1.7] text-muted">{text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section
    id="camino-espiritual"
    class="grid min-h-[420px] items-center gap-[70px] bg-navy px-[clamp(24px,7vw,110px)] py-[105px] text-white max-[900px]:grid-cols-1 max-[900px]:gap-9 max-[620px]:px-5 max-[620px]:py-[74px] grid-cols-[0.9fr_1.1fr]"
  >
    <div class="max-w-[500px]">
      <p class="mb-[26px] flex items-center gap-3 text-[11px] font-bold uppercase tracking-[0.2em] text-white/76">
        <span class="h-px w-[34px] bg-gold"></span>
        El camino espiritual
      </p>
      <h2 class="m-0 font-serif text-[clamp(34px,4.4vw,48px)] leading-[1.1] font-normal tracking-[-0.04em]">
        Un recorrido interior hacia el encuentro con el Señor.
      </h2>
    </div>

    <ul class="border-t border-white/12">
      {
        caminoEspiritual.map(([title, text]) => (
          <li class="border-b border-white/12 py-6">
            <h3 class="m-0 mb-2 font-serif text-xl font-medium text-white">{title}</h3>
            <p class="m-0 text-sm leading-[1.7] text-white/66">{text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section
    id="signos"
    class="bg-paper px-[clamp(24px,7vw,110px)] py-[105px] max-[620px]:px-5 max-[620px]:py-[74px]"
  >
    <p class="mb-[26px] flex items-center gap-3 text-[11px] font-bold uppercase tracking-[0.2em] text-blue">
      <span class="h-px w-[34px] bg-gold"></span>
      Signos y símbolos
    </p>
    <div class="grid grid-cols-3 gap-x-10 gap-y-10 max-[900px]:grid-cols-2 max-[620px]:grid-cols-1">
      {
        signos.map(([title, text]) => (
          <div>
            <h3 class="m-0 mb-2 font-serif text-2xl font-medium text-navy">{title}</h3>
            <p class="m-0 text-sm leading-[1.7] text-muted">{text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section
    id="cita"
    class="flex min-h-[280px] items-center justify-center bg-cream px-[clamp(24px,7vw,110px)] py-[90px] text-center max-[620px]:px-5 max-[620px]:py-[64px]"
  >
    <div class="max-w-[720px]">
      <p class="mb-[26px] flex items-center justify-center gap-3 text-[11px] font-bold uppercase tracking-[0.2em] text-blue">
        <span class="h-px w-[34px] bg-gold"></span>
        Una Palabra para acompañarte
        <span class="h-px w-[34px] bg-gold"></span>
      </p>
      <p class="font-serif text-[clamp(26px,3.4vw,38px)] italic leading-[1.4] tracking-[-0.01em] text-navy">
        «Preparen el camino del Señor, hagan rectos sus senderos.»
      </p>
      <p class="mt-5 text-[11px] font-bold uppercase tracking-[0.2em] text-gold">
        Mateo 3, 3
      </p>
    </div>
  </section>

  <section
    id="cotidiano"
    class="bg-paper px-[clamp(24px,7vw,110px)] py-[105px] max-[620px]:px-5 max-[620px]:py-[74px]"
  >
    <p class="mb-[26px] flex items-center gap-3 text-[11px] font-bold uppercase tracking-[0.2em] text-blue">
      <span class="h-px w-[34px] bg-gold"></span>
      Cómo vivirlo en lo cotidiano
    </p>
    <div class="grid grid-cols-3 gap-10 max-[900px]:grid-cols-1">
      {
        cotidiano.map(([title, text]) => (
          <div class="border-t border-line pt-6">
            <h3 class="m-0 mb-3 font-serif text-xl font-medium text-navy">{title}</h3>
            <p class="m-0 text-sm leading-[1.7] text-muted">{text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section
    id="oracion-breve"
    class="flex min-h-[360px] items-center justify-center bg-navy px-[clamp(24px,7vw,110px)] py-[100px] text-center text-white max-[620px]:px-5 max-[620px]:py-[74px]"
  >
    <div class="max-w-[560px]">
      <p class="mb-[26px] flex items-center justify-center gap-3 text-[11px] font-bold uppercase tracking-[0.2em] text-white/76">
        <span class="h-px w-[34px] bg-gold"></span>
        Oración breve
        <span class="h-px w-[34px] bg-gold"></span>
      </p>
      <p class="font-serif text-[clamp(22px,2.6vw,28px)] leading-[1.6] font-normal text-white/92">
        Señor Jesús,<br />
        despierta mi corazón y enséñame a esperarte.<br />
        Ayúdame a preparar tus caminos,<br />
        a reconocer tu presencia en lo sencillo<br />
        y a llevar tu luz a quienes caminan conmigo.<br />
        Que María me enseñe a recibirte<br />
        con confianza, humildad y alegría.<br />
        Amén.
      </p>
    </div>
  </section>
</Layout>
