---
export const prerender = false;

import { eq } from "drizzle-orm";
import Layout from "@/layout/Layout.astro";
import DailyPrayerView from "@/components/DailyPrayerView.astro";
import { db } from "@/db/client";
import { closingPrayers } from "@/db/schema";
import { todayIso } from "@/lib/dates";

const today = todayIso();
const [prayer] = await db.select().from(closingPrayers).where(eq(closingPrayers.date, today)).limit(1);

Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=0, s-maxage=60, stale-while-revalidate=3600",
);
---

<Layout title="Oración para terminar el día">
  <DailyPrayerView
    date={today}
    prayer={prayer ?? null}
    basePath="/oraciones/oracion-para-terminar-el-dia"
    eyebrow="Oración para terminar el día"
  />
</Layout>
