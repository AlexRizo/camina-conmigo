---
export const prerender = false;

import { eq } from "drizzle-orm";
import Layout from "@/layout/Layout.astro";
import DailyPrayerView from "@/components/DailyPrayerView.astro";
import { db } from "@/db/client";
import { dailyPrayers } from "@/db/schema";
import { slugToIso } from "@/lib/dates";

const { slug } = Astro.params;
const date = slug ? slugToIso(slug) : null;

if (!date) {
  return Astro.redirect("/oraciones/oracion-para-iniciar-el-dia");
}

const [prayer] = await db.select().from(dailyPrayers).where(eq(dailyPrayers.date, date)).limit(1);

Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400",
);
---

<Layout title="Oración para iniciar el día">
  <DailyPrayerView date={date} prayer={prayer ?? null} basePath="/oraciones/oracion-para-iniciar-el-dia" eyebrow="Oración para iniciar el día" />
</Layout>
