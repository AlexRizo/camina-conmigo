---
import { getRecentEpisodes } from "../lib/spotify";

const placeholderGradients = [
  "linear-gradient(#789ba1, #e0c69e 57%, #264d5e 58%)",
  "linear-gradient(#8aa7ac, #e5cfad 58%, #395e68 59%)",
  "linear-gradient(#819fa1, #c5b087 55%, #35594f 56%)",
];

const episodes = await getRecentEpisodes(3).catch(() => []);

const cards = episodes.map((episode, index) => ({
  ...episode,
  date: new Intl.DateTimeFormat("es-ES", { day: "2-digit", month: "short", year: "numeric" })
    .format(new Date(episode.releaseDate))
    .replace(".", "")
    .toUpperCase(),
  gradient: placeholderGradients[index % placeholderGradients.length],
}));
---

<section id="podcast" class="bg-[#faf7f0] px-[clamp(24px,7vw,110px)] py-26.25 max-[620px]:px-5 max-[620px]:py-18.5">
  <div class="mx-auto mb-[38px] flex max-w-300 items-end justify-between max-[620px]:flex-col max-[620px]:items-start max-[620px]:gap-6">
    <div>
      <p class="mb-3.5 flex items-center gap-3 text-[11px] font-bold uppercase tracking-[0.2em] text-blue">
        <span class="h-px w-8.5 bg-gold"></span>
        Sigue caminando
      </p>
      <h2 class="m-0 font-serif text-[clamp(38px,5vw,56px)] leading-[1.05] font-normal tracking-[-0.04em] text-navy">
        Últimos episodios
      </h2>
    </div>
  </div>

  <div class="mx-auto mb-10 grid max-w-300 grid-cols-3 gap-6 max-[900px]:grid-cols-2 max-[620px]:grid-cols-1">
    {
      cards.map((episode) => (
        <article class="bg-paper transition-[transform,box-shadow] duration-[180ms] ease-out hover:-translate-y-1 hover:shadow-[0_18px_44px_rgba(21,48,61,0.1)]">
          <div
            class="relative h-[230px] overflow-hidden"
            style={
              episode.imageUrl
                ? `background: #fff center / contain no-repeat url(${episode.imageUrl});`
                : `background:${episode.gradient};`
            }
          >
            <span class="absolute left-[22px] top-5 z-[2] text-[8px] font-bold uppercase tracking-[0.14em] text-white [text-shadow:0_1px_4px_rgba(0,0,0,.5)]">
              {episode.date}
            </span>
            <a
              href={episode.externalUrl}
              target="_blank"
              rel="noreferrer"
              aria-label={`Escuchar ${episode.name} en Spotify`}
              class="absolute bottom-[18px] right-[18px] z-[2] flex h-11 w-11 items-center justify-center rounded-full bg-[rgba(255,253,248,0.93)] text-gold"
            >
              ▶
            </a>
          </div>
          <div class="p-6.25">
            <h3 class="mb-2.5 font-serif text-[25px] font-medium text-navy">{episode.name}</h3>
            <a
              href={episode.externalUrl}
              target="_blank"
              rel="noreferrer"
              class="text-[9px] font-bold uppercase tracking-widest text-blue"
            >
              Escuchar episodio →
            </a>
          </div>
        </article>
      ))
    }
    {
      cards.length === 0 && (
        <p class="col-span-full py-12.5 text-center text-muted">
          No se pudieron cargar los episodios en este momento.
        </p>
      )
    }
  </div>

  <a
    href="https://open.spotify.com/show/6E0Kks0fEvCGbwy1cmpKUS"
    target="_blank"
    rel="noreferrer"
    class="mx-auto flex min-h-13 w-max items-center justify-center gap-2.5 rounded-xs border border-line px-6.25 text-[11px] font-bold uppercase tracking-widest text-navy"
  >
    Explorar el archivo completo
  </a>
</section>
