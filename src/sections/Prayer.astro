---
---

<section
  id="oracion"
  class="grid grid-cols-[1fr_0.9fr] items-center gap-[clamp(50px,8vw,120px)] px-[clamp(24px,7vw,110px)] py-[105px] max-[900px]:grid-cols-1 max-[620px]:px-5 max-[620px]:py-[74px]"
  style="background: radial-gradient(circle at 8% 100%, rgba(208,181,138,.13), transparent 35%), #f7f3eb;"
>
  <div>
    <p class="mb-[26px] flex items-center gap-3 text-[11px] font-bold uppercase tracking-[0.2em] text-blue">
      <span class="h-px w-[34px] bg-gold"></span>
      Oramos contigo
    </p>
    <h2 class="m-0 mb-6 font-serif text-[clamp(38px,5vw,56px)] leading-[1.05] font-normal tracking-[-0.04em] text-navy">
      Hay intenciones que pesan menos cuando no las llevamos solos.
    </h2>
    <p class="max-w-[570px] font-serif text-lg leading-[1.75] text-muted">
      Puedes compartir aquello por lo que deseas que oremos. Tu intención será
      recibida con respeto, cariño y discreción.
    </p>
    <div class="mt-[34px] flex max-w-[500px] items-center gap-[13px] border-t border-line pt-[22px]">
      <span class="relative inline-block h-[26px] w-[22px] flex-none" aria-hidden="true">
        <i class="absolute left-1/2 top-1/2 h-[25px] w-0.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-gold not-italic"></i>
        <b class="absolute left-1/2 top-[36%] h-0.5 w-[14px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-gold font-normal not-italic"></b>
      </span>
      <span class="flex flex-col text-[11px] leading-[1.6] text-[#829092]">
        <strong class="text-xs text-navy">Un espacio privado y seguro</strong>
        Tu intención no se publicará.
      </span>
    </div>
  </div>

  <form
    data-prayer-form
    class="relative min-h-[490px] bg-paper p-[clamp(28px,4vw,48px)] shadow-[0_18px_60px_rgba(28,56,67,0.08)]"
  >
    <div data-form-fields>
      <label
        class="absolute -left-[9999px] top-auto h-px w-px overflow-hidden"
        aria-hidden="true"
      >
        Empresa
        <input name="company" tabindex="-1" autocomplete="off" />
      </label>
      <label class="mb-5 block text-[10px] font-bold uppercase tracking-[0.1em] text-navy">
        Nombre <span class="text-[8px] font-medium tracking-normal text-[#a5acad] normal-case">(opcional)</span>
        <input
          name="name"
          placeholder="¿Cómo podemos llamarte?"
          class="mt-[9px] block w-full border border-line bg-[#fbf8f2] p-[14px] text-sm normal-case text-ink outline-none focus:border-gold"
        />
      </label>
      <label class="mb-5 block text-[10px] font-bold uppercase tracking-[0.1em] text-navy">
        Correo <span class="text-[8px] font-medium tracking-normal text-[#a5acad] normal-case">(opcional)</span>
        <input
          name="email"
          type="email"
          placeholder="tu@correo.com"
          class="mt-[9px] block w-full border border-line bg-[#fbf8f2] p-[14px] text-sm normal-case text-ink outline-none focus:border-gold"
        />
      </label>
      <label class="mb-5 block text-[10px] font-bold uppercase tracking-[0.1em] text-navy">
        Tu intención de oración
        <textarea
          name="prayer"
          required
          rows="5"
          placeholder="Escribe aquí aquello que llevas en el corazón…"
          class="mt-[9px] block w-full resize-y border border-line bg-[#fbf8f2] p-[14px] text-sm normal-case text-ink outline-none focus:border-gold"
        ></textarea>
      </label>
      <label class="mb-[22px] flex items-center gap-[9px] text-[11px] text-[#727e80]">
        <input type="checkbox" name="anonymous" />
        <span>Prefiero enviarla de forma anónima</span>
      </label>
      <button
        type="submit"
        class="flex min-h-[52px] w-full items-center justify-center gap-[10px] rounded-[2px] bg-gold px-[25px] text-[11px] font-bold uppercase tracking-[0.1em] text-white transition-transform duration-150 hover:-translate-y-0.5"
      >
        Enviar mi intención
      </button>
      <small class="mt-[14px] block text-center text-[8px] leading-[1.5] text-[#a1a8a9]">
        Al enviar, autorizas el manejo privado de esta intención exclusivamente
        para acompañamiento en oración.
      </small>
    </div>

    <div data-form-success role="status" hidden class="flex min-h-[390px] flex-col items-center justify-center text-center">
      <span class="relative inline-block h-[38px] w-[30px]" aria-hidden="true">
        <i class="absolute left-1/2 top-1/2 h-9 w-0.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-gold not-italic"></i>
        <b class="absolute left-1/2 top-[36%] h-0.5 w-[18px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-gold font-normal not-italic"></b>
      </span>
      <h3 class="mt-[18px] mb-2 font-serif text-[31px] font-medium text-navy">Tu intención ha sido recibida.</h3>
      <p class="max-w-[320px] text-muted">Gracias por confiarla. Caminamos y oramos contigo.</p>
      <button
        type="button"
        data-reset-form
        class="mt-5 border-0 border-b border-gold bg-transparent text-blue"
      >
        Enviar otra intención
      </button>
    </div>
  </form>
</section>

<script>
  const prayerForm = document.querySelector<HTMLFormElement>("[data-prayer-form]");
  const fields = document.querySelector<HTMLElement>("[data-form-fields]");
  const success = document.querySelector<HTMLElement>("[data-form-success]");

  prayerForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!prayerForm) return;
    const response = await fetch("/api/oracion", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(Object.fromEntries(new FormData(prayerForm))),
    });
    if (!response.ok) {
      const message =
        response.status === 429
          ? "Demasiados envíos. Intenta de nuevo en unos minutos."
          : "No fue posible enviar la intención. Intenta nuevamente.";
      window.alert(message);
      return;
    }
    fields?.toggleAttribute("hidden", true);
    success?.toggleAttribute("hidden", false);
  });

  document
    .querySelector<HTMLButtonElement>("[data-reset-form]")
    ?.addEventListener("click", () => {
      prayerForm?.reset();
      fields?.toggleAttribute("hidden", false);
      success?.toggleAttribute("hidden", true);
    });
</script>
