---
---

<section
  id="inicio"
  class="relative flex min-h-[760px] items-center overflow-hidden px-[clamp(28px,8vw,130px)] pt-[150px] pb-[84px] text-white max-[900px]:min-h-[700px] max-[900px]:pt-[135px] max-[620px]:min-h-[720px] max-[620px]:px-[22px] max-[620px]:pt-[135px] max-[620px]:pb-[80px]"
  style="background: linear-gradient(90deg, rgba(19,52,69,.98) 0%, rgba(25,61,79,.92) 43%, rgba(31,67,83,.55) 65%, rgba(224,207,181,.18) 100%), radial-gradient(circle at 82% 33%, #f1d9b0 0 4%, #a9c1c4 18%, #3b6b79 44%, #17394b 75%);"
>
  <div
    class="pointer-events-none absolute inset-0"
    style="background: linear-gradient(180deg, transparent, rgba(14,42,59,.28));"
  >
  </div>

  <div
    aria-hidden="true"
    class="absolute -right-[20px] top-[80px] h-[660px] w-[700px] rounded-full max-[900px]:-right-[390px] max-[900px]:opacity-55"
    style="background: radial-gradient(circle, rgba(252,226,174,.7), rgba(233,207,165,.14) 25%, transparent 62%);"
  >
  </div>

  <div
    aria-hidden="true"
    class="absolute -right-[100px] -bottom-[160px] h-[590px] w-[760px] rotate-[-18deg] rounded-full blur-[1px] max-[900px]:-right-[430px] max-[900px]:opacity-60"
    style="border-style: solid; border-color: rgba(240,224,198,.38); border-width: 0 0 70px;"
  >
    <div
      class="absolute -right-[20px] bottom-[60px] h-[230px] w-[700px] rounded-[50%_30%_0_0]"
      style="background: linear-gradient(90deg, transparent, rgba(15,51,65,.75));"
    >
    </div>
    <div
      class="absolute right-[140px] bottom-[110px] h-[230px] w-[700px] scale-[0.8] rounded-[50%_30%_0_0] opacity-55"
      style="background: linear-gradient(90deg, transparent, rgba(15,51,65,.75));"
    >
    </div>
  </div>

  <div class="relative z-[2] max-w-[710px]">
    <p class="mb-[26px] flex items-center gap-3 text-[11px] font-bold uppercase tracking-[0.2em] text-white/76">
      <span class="h-px w-[34px] bg-gold"></span>
      La Biblia católica a la luz del Año Litúrgico
    </p>
    <h1
      class="m-0 font-serif text-[clamp(50px,6vw,82px)] leading-[1.05] tracking-[-0.045em] font-normal max-[620px]:text-[46px]"
    >
      Una pausa para escuchar.<br />
      <em class="font-normal not-italic text-[#e0c295]">Un camino para vivir.</em>
    </h1>
    <p
      class="my-[28px] max-w-[550px] font-serif text-lg leading-[1.7] text-white/77 max-[620px]:text-base"
    >
      Cada día, una reflexión para encontrarte con la Palabra de Dios y llevarla
      contigo a la vida cotidiana.
    </p>
    <div class="flex flex-wrap items-center gap-8 max-[620px]:flex-col max-[620px]:items-start max-[620px]:gap-4">
      <a
        href="#episodio"
        class="inline-flex min-h-[52px] items-center justify-center gap-[10px] rounded-[2px] bg-gold px-[25px] text-[11px] font-bold uppercase tracking-[0.1em] text-white transition-transform duration-150 hover:-translate-y-0.5"
      >
        <span class="text-[10px]" aria-hidden="true">▶</span>
        Escuchar el episodio de hoy
      </a>
      <a
        href="#podcast"
        class="border-b border-white/42 py-2 text-xs font-semibold tracking-[0.04em] text-white"
      >
        Ver todos los episodios <span class="ml-1.5 text-gold">→</span>
      </a>
    </div>
  </div>

  <div
    aria-hidden="true"
    class="absolute bottom-[38px] left-[clamp(28px,8vw,130px)] z-[2] flex items-center gap-3 text-[8px] font-bold uppercase tracking-[0.2em] text-white/48 max-[620px]:left-[22px]"
  >
    <span class="relative flex h-7 w-7 items-center justify-center rounded-full border border-white/35">
      <span class="text-gold">↓</span>
    </span>
    Camina un poco más
  </div>
</section>
